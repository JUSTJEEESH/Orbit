{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0",

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "__MSG_action_title__",
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting"
  ]
}
